# Copy to .env. Values below are the local docker-compose defaults; production reads these from Key Vault.
APP_NAME=employeedesk-api
APP_VERSION=0.0.1
DEBUG=true

DATABASE_URL=postgresql+asyncpg://employeedesk:employeedesk@127.0.0.1:5433/employeedesk
DATABASE_ECHO=false
REDIS_URL=redis://127.0.0.1:6380/0

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DEFAULT_LANGUAGE=en
ALLOWED_HOSTS=
CORS_ORIGINS=http://localhost:3010

# Azure AI Foundry project endpoint (OpenAI v1 compatible). Empty = no embeddings, no assistant.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_REASONING_EFFORT=minimal
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

MOCK_ERP_URL=http://127.0.0.1:8013
